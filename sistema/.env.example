# Copiar a .env y completar. .env NO se versiona.

# Entorno de la app: development, testing o production.
APP_ENV=development

# Base compartida en Supabase: cadena del Session pooler (Project Settings > Database).
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<contraseña>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Base local SOLO para tests (los tests nunca usan la de Supabase). Si no existe, los tests
# la crean; en cada corrida borran su esquema public y aplican supabase/migrations en orden.
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@localhost:5432/exoma_test
# Base local para probar en el navegador (opcional). `flask migrar-local` le aplica las
# migraciones; si está definida, `flask run` en desarrollo la usa en vez de DATABASE_URL.
DATABASE_URL_LOCAL=postgresql+psycopg://postgres:postgres@localhost:5432/exoma_local

# Clave para firmar la sesión. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Contraseña de los usuarios de prueba que crea `flask seeds` (uno por rol, <rol>@exoma.test).
# En desarrollo, si queda vacía, es prueba1234. En producción es obligatoria.
SEEDS_CONTRASENA=

# Servidor de mail para notificaciones y credenciales (en desarrollo el envío se suprime).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Dirección pública del sistema, para los links de los mails (por defecto http://localhost:5000).
URL_BASE=http://localhost:5000

# Supabase Storage para los PDFs.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_KEY=
# Bucket privado donde van los archivos (por defecto documentos).
SUPABASE_BUCKET=documentos

# Apigen (módulo 5): URL base y clave de acceso (apigen/contrato.md, Conexión).
APIGEN_URL=https://edmrjmfjklwgazzztjcl.supabase.co/rest/v1
APIGEN_KEY=
# Identificador del grupo para las patologías propias en Apigen (por defecto grupo10).
APIGEN_GRUPO_ID=grupo10

# Chatbot de pacientes de GenLab (docs/apis/chatbot.md). La URL y la clave publishable son las
# mismas para todos los grupos; el token es solo nuestro: nunca a Git ni al navegador.
CHATBOT_URL=https://vglzngsrbyagquqqmakf.supabase.co/functions/v1/chat
CHATBOT_APIKEY=
CHATBOT_TOKEN=
# APIs provisorias de transcripción y familiograma (docs/apis/).
TRANSCRIPCION_URL=
FAMILIOGRAMA_URL=
# API de cupones (docs/apis/cupones.md): clave del grupo, solo en .env.
CUPONES_URL=https://vekuhonbpqtzakqbcoph.supabase.co/functions/v1/cupones-api
CUPONES_KEY=
# Módulo de obras sociales (módulo 6, grupo 9; docs/apis/obras_sociales.md). La clave es la del
# grupo 10 y va en el header x-api-key: nunca a Git.
OBRAS_SOCIALES_URL=https://bxsvmfesrtjrqubblgws.supabase.co/functions/v1/api
OBRAS_SOCIALES_KEY=
# Módulo de optimización de recorridos (módulo 9; docs/apis/optimizacion.md). No pide clave.
OPTIMIZACION_URL=https://optimizacionapi.vercel.app/api
OPTIMIZACION_KEY=

# Bot de mensajería de Telegram (E22, borrador en docs/apis/telegram.md). Secreto que se pasa como
# secret_token al registrar el webhook (setWebhook): Telegram lo manda en el header
# X-Telegram-Bot-Api-Secret-Token y sin él POST /bot/telegram responde 403. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# 1 = las integraciones responden con los mocks de tests/fixtures/apis/ en vez de llamar a las APIs
# (y storage guarda los archivos en instance/storage/).
USE_MOCKS=1

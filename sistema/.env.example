# Copiar a .env y completar. .env NO se versiona.

# Entorno de la app: development, testing o production.
APP_ENV=development

# Base compartida en Supabase: cadena del Session pooler (Project Settings > Database).
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<contraseña>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Base local SOLO para tests (los tests nunca usan la de Supabase). Si no existe, los tests
# la crean; en cada corrida borran su esquema public y aplican supabase/migrations en orden.
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@localhost:5432/exoma_test

# Clave para firmar la sesión. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Servidor de mail para notificaciones y credenciales (en desarrollo el envío se suprime).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Supabase Storage para los PDFs.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_KEY=

# Apigen (módulo 5): URL base y clave de acceso.
APIGEN_URL=
APIGEN_KEY=

# 1 = las integraciones responden con los mocks de tests/fixtures/apis/ en vez de llamar a las APIs.
USE_MOCKS=1

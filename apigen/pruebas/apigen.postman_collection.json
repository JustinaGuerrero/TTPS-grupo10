    {
      "name": "Pruebas",
      "item": [
        {
          "name": "1. Buscar genes que empiezan con GA (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{key}}"
              }
            ],
            "url": "{{base}}/gen?simbolo=ilike.GA%2A&select=simbolo&order=simbolo&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Incluye GAA\", function () {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.map(x => x.simbolo)).to.include('GAA');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Listar patologías (200, las 6 base con su herencia)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/rpc/listar_patologias",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Las 6 base, con herencia\", function () {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.filter(x => !x.de_grupo).length).to.eql(6);",
                  "  d.forEach(x => pm.expect(x).to.have.property('herencia'));",
